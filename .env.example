# Copy to .env for local development (never commit .env).
# On Hugging Face Spaces: Settings → Repository secrets → add the same variable names.

# ── YouTube Music full playback (optional) ─────────────────────────────────
# Export youtube.com cookies as Netscape cookies.txt (browser extension:
# "Get cookies.txt LOCALLY" while logged into YouTube).
#
# Option A — paste entire file contents (recommended for HF secrets):
# YTMUSIC_YOUTUBE_COOKIES=# Netscape HTTP Cookie File
# .youtube.com	TRUE	/	TRUE	1234567890	SID	your_value_here
#
# Option B — path to cookies file on disk (local dev only):
# YTMUSIC_YOUTUBE_COOKIES_FILE=./cookies.txt
#
# When set, yt-dlp uses your session and full tracks can play on cloud hosting.
# Without cookies, playback falls back to Invidious / Piped / 30s iTunes preview.

# YTMUSIC_YOUTUBE_COOKIES=

# Force yt-dlp without cookies (local/VPS only; usually blocked on HF free tier):
# YTMUSIC_ENABLE_YTDLP=true

# Internal Python service URL (Docker default):
# YTMUSIC_SERVICE_URL=http://127.0.0.1:8000
